import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

export default function DashboardImmobilier() {
  const [clients, setClients] = useState([]);
  const [form, setForm] = useState({
    nom: "",
    appartement: "",
    date: "",
    montant: "",
    charges: "",
  });

  const ajouterClient = () => {
    if (!form.nom) return;
    setClients([...clients, form]);
    setForm({ nom: "", appartement: "", date: "", montant: "", charges: "" });
  };

  const totalRevenus = clients.reduce((acc, c) => acc + Number(c.montant || 0), 0);
  const totalCharges = clients.reduce((acc, c) => acc + Number(c.charges || 0), 0);

  return (
    <div className="p-6 grid gap-6">
      <h1 className="text-2xl font-bold">Dashboard Immobilier</h1>

      {/* Formulaire */}
      <Card className="p-4">
        <CardContent className="grid gap-3">
          <Input
            placeholder="Nom du client"
            value={form.nom}
            onChange={(e) => setForm({ ...form, nom: e.target.value })}
          />
          <Input
            placeholder="Appartement"
            value={form.appartement}
            onChange={(e) => setForm({ ...form, appartement: e.target.value })}
          />
          <Input
            type="date"
            value={form.date}
            onChange={(e) => setForm({ ...form, date: e.target.value })}
          />
          <Input
            type="number"
            placeholder="Revenu (MAD)"
            value={form.montant}
            onChange={(e) => setForm({ ...form, montant: e.target.value })}
          />
          <Input
            type="number"
            placeholder="Charges (MAD)"
            value={form.charges}
            onChange={(e) => setForm({ ...form, charges: e.target.value })}
          />
          <Button onClick={ajouterClient}>Ajouter Réservation</Button>
        </CardContent>
      </Card>

      {/* Résumé */}
      <div className="grid grid-cols-3 gap-4">
        <Card className="p-4">
          <CardContent>
            <p>Total Revenus</p>
            <h2 className="text-xl font-bold">{totalRevenus} MAD</h2>
          </CardContent>
        </Card>
        <Card className="p-4">
          <CardContent>
            <p>Total Charges</p>
            <h2 className="text-xl font-bold">{totalCharges} MAD</h2>
          </CardContent>
        </Card>
        <Card className="p-4">
          <CardContent>
            <p>Bénéfice</p>
            <h2 className="text-xl font-bold">{totalRevenus - totalCharges} MAD</h2>
          </CardContent>
        </Card>
      </div>

      {/* Liste clients */}
      <Card className="p-4">
        <CardContent>
          <h2 className="text-lg font-bold mb-3">Réservations</h2>
          <table className="w-full text-left">
            <thead>
              <tr>
                <th>Client</th>
                <th>Appartement</th>
                <th>Date</th>
                <th>Revenu</th>
                <th>Charges</th>
              </tr>
            </thead>
            <tbody>
              {clients.map((c, i) => (
                <tr key={i} className="border-t">
                  <td>{c.nom}</td>
                  <td>{c.appartement}</td>
                  <td>{c.date}</td>
                  <td>{c.montant} MAD</td>
                  <td>{c.charges} MAD</td>
                </tr>
              ))}
            </tbody>
          </table>
        </CardContent>
      </Card>
    </div>
  );
}
